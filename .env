# --- База данных ---
DATABASE_URL=postgresql://remotebrief:remotebrief@localhost:5432/remotebrief

# --- S3-совместимое хранилище (документы, PDF протоколов) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=remotebrief
S3_SECRET_KEY=remotebrief123
S3_BUCKET=remotebrief-docs

# --- SMTP: доставка протоколов в офис ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=remotebrief@example.com
PROTOCOL_NOTIFY_EMAIL=ot-department@example.com

# --- Аутентификация ---
# Подпись JWT-сессий сотрудников (rb_session) и консоли (rb_admin)
AUTH_SECRET=change-me-in-production
# TTL личного кода сотрудника (заготовка для приглашений, фаза 1 — seed: 30 дней)
ACCESS_CODE_TTL_MINUTES=30

# --- Приложение ---
# Базовый URL для ссылок в письмах (протокол -> консоль комиссии)
APP_URL=http://localhost:3000

# --- ИИ-наставник (провайдер-agnostic) ---
# gigachat | yandexgpt | openai-compatible
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.example-llm.ru/v1
AI_API_KEY=change-me
AI_MODEL=gigachat
EMBEDDING_MODEL=emb-2025-1
# TTS (озвучивание документов) и ASR (голосовые вопросы)
AI_TTS_ENABLED=true
AI_ASR_ENABLED=true
# HTTP-адрес сервиса ИИ-наставника (apps/ai-mentor)
AI_MENTOR_URL=http://localhost:8001

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
